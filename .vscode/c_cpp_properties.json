{
    "env": {
        "myIncludePath": [
            "/workspace/holoscan-sdk/include",
            "${workspaceFolder}/operators",
            "${workspaceFolder}"
        ],
        "myDefines": [
            "DEBUG",
            "MY_FEATURE=1"
        ]
    },
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${myIncludePath}",
                "${workspaceFolder}/operators/advanced_network",
                "/opt/nvidia/holoscan/include",
                "/opt/nvidia/holoscan/include/gxf",
                "/opt/nvidia/holoscan/include/3rdparty",
                "/opt/nvidia/holoscan/include/3rdparty/ucx",
                "/opt/nvidia/holoscan/include/3rdparty/matx",
                "/usr/local/cuda/targets/sbsa-linux/include"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu11",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}